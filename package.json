{
  "name": "invoice-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:demo": "tsx watch server/index.ts --demo",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "start:demo": "tsx server/index.ts --production --demo",
    "test": "tsx --test tests/*.test.ts",
    "setup:browser": "playwright install chromium",
    "check:connections": "tsx scripts/check-connections.ts"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "playwright": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
